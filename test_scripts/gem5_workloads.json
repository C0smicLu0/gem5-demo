{
  "base_run_root": "tests/testing-results",
  "gem5_opt_args": "-re",
  "config_args": "--reg-alloc-policy=dynamic --stats-dump-mode=full --mem-size=8GB",
  "config_profiles": {
    "pressure": {
      "default": "--l1d_size=512B --l1i_size=512B --l2_size=1KiB --l2-latency=50 --l2-hit-latency=18 --cpu-to-dir-latency=120 --recycle-latency=10 --l3-data-latency=20 --l3-tag-latency=15 --router-latency=1 --link-latency=1"
    },
    "cores": {
      "args0": "-n3 -u240",
      "args1": "-n16 -u224",
      "args2": "-n32 -u208",
      "args3": "-n48 -u192",
      "args4": "-n64 -u176",
      "args5": "-n80 -u160"
    }
  },
  "workloads": {
    "square": {
      "workload_args": "--mem-size=8GB -c /gem5/tests/gem5/gpu/square_modified_src/square/bin/square-gpu-test"
    },
    "hacc": {
      "workload_args": "--mem-size=8GB -c /gem5/tests/gem5/gpu/hacc_modified_src/halo-finder/src/hip/ForceTreeTest --options '0.5 0.1 64 0.1 1 N 12 rcb'"
    },
    "pannotia-bc-1k-128k": {
      "workload_args": "--mem-size=8GB -c /gem5/tests/gem5/gpu/pannotia_modified_src/pannotia/bc/bin/bc.gem5 --options /gem5/tests/gem5/gpu/pannotia_modified_src/pannotia/datasets/1k_128k.gr"
    },
    "pannotia-color-maxmin-1k-128k": {
      "workload_args": "--mem-size=8GB -c /gem5/tests/gem5/gpu/pannotia_modified_src/pannotia/color/bin/color_maxmin.gem5 --options '/gem5/tests/gem5/gpu/pannotia_modified_src/pannotia/datasets/1k_128k.gr 0'"
    },
    "pannotia-color-max-1k-128k": {
      "workload_args": "--mem-size=8GB -c /gem5/tests/gem5/gpu/pannotia_modified_src/pannotia/color/bin/color_max.gem5 --options '/gem5/tests/gem5/gpu/pannotia_modified_src/pannotia/datasets/1k_128k.gr 0'"
    },
    "rodinia-bfs": {
      "workload_args": "-c /gem5/rodinia_hip/hip_mod/bin/bfs.out --options '/gem5/rodinia_hip/data/bfs/graph65536.txt'"
    },
    "rodinia-gaussian": {
      "workload_args": "-c /gem5/rodinia_hip/hip_mod/bin/gaussian --options '-f /gem5/rodinia_hip/data/gaussian/matrix80.txt'"
    },
    "rodinia-hotspot": {
      "workload_args": "-c /gem5/rodinia_hip/hip_mod/bin/hotspot --options '64 2 2 /gem5/rodinia_hip/data/hotspot/temp_64 /gem5/rodinia_hip/data/hotspot/power_64'"
    },
    "rodinia-lavaMD": {
      "workload_args": "-c /gem5/rodinia_hip/hip_mod/bin/lavaMD --options '-boxes1d 10'"
    },
    "rodinia-nw": {
      "workload_args": "-c /gem5/rodinia_hip/hip_mod/bin/needle --options '32 10'"
    },
    "rodinia-particlefilter": {
      "workload_args": "-c /gem5/rodinia_hip/hip_mod/bin/particlefilter_float --options '-x 64 -y 64 -z 6 -np 1000'"
    }
  }
}
